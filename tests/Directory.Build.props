<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    テストは src と同じプロジェクト名 (Domain など) を使うため、.Tests を付けて衝突を避ける。
    src/Domain と tests/Domain が対応していることが、名前から読み取れる。
  -->
  <PropertyGroup>
    <AssemblyName>Netsoft.MessageQueues.$(MSBuildProjectName).Tests</AssemblyName>
    <RootNamespace>Netsoft.MessageQueues.$(MSBuildProjectName).Tests</RootNamespace>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
