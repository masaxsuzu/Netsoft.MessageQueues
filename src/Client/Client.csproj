<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ブローカーへ外から繋ぐ側。発行の口と、購読者を回す常駐を持つ。

    **Runtime を参照する。** 利用者が書くのはプロセス内と同じ IMessageSubscriber で、
    その契約と Message / Topic / Lane はあちらに居る。参照しなければ客の側だけ別の
    インタフェースになり、「処理をどこで走らせるかだけが違う」という約束が崩れる。
    連れてくる配送エンジンはここでは使わないが、SQLite は付いてこない
    （Runtime は Infrastructure を参照しない）ので、繋ぐだけの側が DB を抱えることはない。
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Contracts\Contracts.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Runtime\Runtime.csproj" />
  </ItemGroup>

</Project>
